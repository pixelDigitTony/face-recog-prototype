 skinparam shadowing false
 actor Operator
 participant "Camera / per-face cards" as UI
 participant "Multi-enrollment coordinator" as Flow
 participant "Per-track state map" as Tracks
 participant "YuNet / SFace worker" as Recognition
 participant "Shared multi-face MediaPipe worker" as Pose
 participant "Exclusive pose association" as Associate
 database "localStorage schema 5" as DB
 Operator -> UI : name Face 1; Enter\nname Face 2; Enter
 UI -> Flow : bind each fresh track independently
 Flow -> Tracks : person drafts, challenges and immutable settings
 loop bounded frame processing
   UI -> Recognition : scene frame; at most two recognition crops per comparison
   Recognition --> Flow : detections and embeddings keyed by detection ID
   UI -> Pose : scene frame; optional independent blink observations
   Pose --> Associate : multiple boxes, yaw and eye scores
   Flow -> Associate : tracked boxes and ambiguity flags
   Associate --> Tracks : exclusive observations keyed by track ID
   loop each active enrollment
     Tracks -> Tracks : update only own steps and capture consistency
     alt ready single capture
       Tracks -> DB : atomic person + sample + attempt
       DB --> UI : per-face saved / retry result
     else ready guided set
       Tracks --> UI : sealed per-face review; others continue
       Operator -> UI : Save this person's three samples
       UI -> DB : atomic per-person sample set
     else lost / uncertain association
       Tracks --> UI : cancel only this draft; preserve other sessions
     end
   end
 end
